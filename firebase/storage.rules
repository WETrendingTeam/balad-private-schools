rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function staffDoc() { return firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)); }
    function isControl() { return signedIn() && staffDoc().data.active == true && staffDoc().data.role == 'control'; }
    function isClassTeacherForStudent(studentId) {
      return signedIn() &&
        staffDoc().data.active == true &&
        staffDoc().data.role == 'class_teacher' &&
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.classTeacherUid == request.auth.uid;
    }

    match /public/staff/{fileName=**} {
      allow read: if true;
      allow write: if isControl();
    }
    match /public/pages/{fileName=**} {
      allow read: if true;
      allow write: if isControl();
    }
    match /public/gallery/{fileName=**} {
      allow read: if true;
      allow write: if isControl();
    }

    // Class Teachers can upload/read passports only after the student profile
    // has been assigned to that Class Teacher by the Worker.
    match /students/passports/{studentId}/{fileName} {
      allow read: if true;
      allow write: if isControl() || isClassTeacherForStudent(studentId);
    }

    // Existing flat passport paths remain Control-only for compatibility.
    match /students/passports/{fileName=**} {
      allow read, write: if isControl();
    }
  }
}
