rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function staffDoc() { return firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)); }
    function isControl() { return signedIn() && staffDoc().data.active == true && staffDoc().data.role == "control"; }
    function isClassTeacher() { return signedIn() && staffDoc().data.active == true && staffDoc().data.role == "class_teacher"; }
    function ownsStudent(string studentId) {
      return isClassTeacher() &&
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.classTeacherUid == request.auth.uid;
    }

    // Public website media: anyone may view; only CONTROL001 may upload/change.
    match /public/staff/{fileName=**} {
      allow read: if true;
      allow write: if isControl();
    }
    match /public/pages/{fileName=**} {
      allow read: if true;
      allow write: if isControl();
    }
    match /public/gallery/{fileName=**} {
      allow read: if true;
      allow write: if isControl();
    }

    // Existing student passport storage used by the Student/ID system.
    match /students/passports/{studentId}/{fileName=**} {
      allow read, write: if isControl() || ownsStudent(studentId);
    }
  }
}
